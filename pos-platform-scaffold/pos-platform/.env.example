# ---- shared ----
NODE_ENV=development

# ---- apps/api ----
DATABASE_URL="postgresql://user:password@localhost:5432/pos_dev"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
AI_SERVICE_TOKEN="shared-secret-between-api-and-ai"
PORT=4000

# M-Pesa Daraja (sandbox first — per-merchant values are stored encrypted in
# the tenant settings table at runtime, these are for local/dev only)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://your-render-app.onrender.com/payments/mpesa/callback

# ---- apps/ai ----
AI_PORT=8000
DATABASE_URL_READONLY="postgresql://readonly_role:password@localhost:5432/pos_dev"
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter
LLM_DAILY_CALL_CAP_PER_TENANT=200

# ---- apps/web ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_BUILD_ID=dev

# ---- shared ----
NODE_ENV=development

# ---- apps/api ----
DATABASE_URL="postgresql://user:password@localhost:5432/pos_dev"
JWT_ACCESS_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
AI_SERVICE_TOKEN="shared-secret-between-api-and-ai"
PORT=4000

# M-Pesa Daraja. The shortcode/type/environment a merchant edits live in
# /settings/mpesa; the secrets below are read from the environment only —
# they are never stored in, or returned by, the API. Leaving them blank is
# valid: the API boots, M-Pesa sales stay PENDING, and /settings/mpesa
# reports `configured: false` instead of pretending a push would go out.
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://your-render-app.onrender.com/payments/mpesa/callback

# The published, stable origin this API is reachable at. Daraja needs a public
# HTTPS URL for the callback, and the scheduler uses this to keep a free-tier
# instance awake during trading hours. Leave blank locally — the keep-awake
# job simply stays off.
PUBLIC_BASE_URL=

# In-process scheduler: the every-minute M-Pesa recheck and the trading-hours
# keep-awake ping (apps/api/src/jobs/scheduler.ts).
SCHEDULER_ENABLED=true
TRADING_HOURS_START=6
TRADING_HOURS_END=22
TRADING_TIMEZONE=Africa/Nairobi

# ---- apps/ai ----
AI_PORT=8000
DATABASE_URL_READONLY="postgresql://readonly_role:password@localhost:5432/pos_dev"
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openrouter
LLM_DAILY_CALL_CAP_PER_TENANT=200

# ---- apps/web ----
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_AI_URL=http://localhost:8000
NEXT_PUBLIC_BUILD_ID=dev
